#include <windows.h>

1 ICON "../../../../Resources/AppIcon.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "E-Ink Assistant\0"
            VALUE "FileDescription", "E-Ink Assistant for Windows\0"
            VALUE "FileVersion", "1.2.0.0\0"
            VALUE "InternalName", "EinkAssistant.exe\0"
            VALUE "OriginalFilename", "EinkAssistant.exe\0"
            VALUE "ProductName", "E-Ink Assistant for Windows\0"
            VALUE "ProductVersion", "1.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
